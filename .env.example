# Copy to .env for local runs. .env is gitignored -- never commit real values.
#
#   cp .env.example .env
#
# Every variable below is read by mbpp/config.py.

# ---------------------------------------------------------------- app basics
# production | development | testing. `production` is strict: it refuses to
# start without SECRET_KEY and a project id.
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

PORT=8080
LOG_LEVEL=INFO
# JSON lines for Cloud Logging; set false for readable local output.
LOG_JSON=false

# ------------------------------------------------------------------ firebase
DATABASE_ENABLED=true
FIREBASE_PROJECT_ID=mbpp-7347c

# Which Firebase database to write to: "rtdb" (Realtime Database, what this
# project has provisioned) or "firestore".
DATABASE_BACKEND=rtdb

# Required for rtdb -- copy it from the Realtime Database page in the console.
FIREBASE_DATABASE_URL=https://mbpp-7347c-default-rtdb.firebaseio.com

# Credentials -- pick exactly one:
#   1. Cloud Run / GCE: set neither. Application Default Credentials are
#      injected from the runtime service account (the preferred option: no key
#      to leak or rotate).
#   2. Local development: point at a downloaded key file.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/mbpp-service-account.json
#   3. Platforms with env vars only (Render, Fly): paste the key JSON, or its
#      base64, into this variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Local emulator instead of the real database:
#   firebase emulators:start --only database
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Where the data lives in the RTDB JSON tree.
RTDB_PREDICTIONS_PATH=predictions
RTDB_STATS_PATH=stats

DB_TIMEOUT_SECONDS=5
DB_RETRIES=2

# Only used when DATABASE_BACKEND=firestore
# FIRESTORE_DATABASE=(default)
# FIRESTORE_PREDICTIONS_COLLECTION=predictions
# FIRESTORE_STATS_COLLECTION=stats
# FIRESTORE_STATS_DOC=global
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088

# ------------------------------------------------------------------- privacy
# Store the submitted snippet (truncated) with the prediction. The SHA-256 is
# stored either way, so analytics still work with this off.
STORE_RAW_TEXT=true
STORED_TEXT_MAX_CHARS=1000

# Days before a prediction may be deleted. 0 = keep forever.
# Firestore enforces this itself via a TTL policy. The Realtime Database has no
# TTL feature, so there you must run tools/prune_predictions.py on a schedule.
PREDICTION_TTL_DAYS=90

# Required to record hashed client IPs at all -- without a salt, an IP hash is
# reversible by brute force, so the field is dropped instead.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=

# -------------------------------------------------------------- http / limits
MIN_SNIPPET_CHARS=3
MAX_SNIPPET_CHARS=5000
MAX_CONTENT_LENGTH=65536

# Forwarding hops to trust for the client IP. Cloud Run = 1. Add one per extra
# proxy (e.g. Netlify in front of Cloud Run = 2). Too high lets clients spoof
# their IP and evade rate limiting.
TRUSTED_PROXY_COUNT=1

# Only needed when the browser calls the backend directly instead of through
# the Netlify /api/* proxy. Comma-separated, no wildcards in production.
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

ENABLE_HSTS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# -------------------------------------------------------------------- models
MODEL_DIR=models
PRELOAD_MODELS=true
# Optional: overrides the content hash used to tag stored predictions.
# MODEL_VERSION=

# ------------------------------------------------------------------ gunicorn
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120

# -------------------------------------------------------------------- netlify
# Set in Netlify's UI, not here: the backend origin the /api/* proxy targets.
# BACKEND_URL=https://mbpp-backend-xxxxxxxxxx-uc.a.run.app
