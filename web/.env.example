# ---------------------------------------------------------------- Firebase ---
# Console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
#
# These are inlined into the client bundle at BUILD time and are safe to expose:
# the Realtime Database rules in database.rules.json, not secrecy, are what keep
# one user out of another's results. Because they are inlined, changing one
# requires a rebuild — an env-var edit alone does nothing.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------ Gemini ---
# Powers the in-app assistant and the questionnaire auto-fill
# (aistudio.google.com/apikey). Server-side only — never prefix with
# NEXT_PUBLIC_, which would inline it into the browser bundle.
#
# Without it the assistant reports that it is unconfigured, and the auto-fill
# falls back to a local simulator that labels its results as simulated.

GEMINI_API_KEY=
