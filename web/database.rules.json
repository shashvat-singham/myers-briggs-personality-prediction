{
  "rules": {
    ".read": false,
    ".write": false,

    "predictions": {
      ".read": false,
      ".write": false,
      ".indexOn": ["personality_type", "created_at"]
    },

    "stats": {
      ".read": false,
      ".write": false
    },

    "users": {
      "$uid": {
        "results": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$resultId": {
            ".validate": "newData.hasChildren(['type', 'axes', 'tally', 'answers', 'durationMs', 'createdAt'])",
            "type": { ".validate": "newData.isString() && newData.val().length === 4" },
            "durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "serverCreatedAt": { ".validate": "newData.isNumber()" },
            "source": { ".validate": "newData.isString() && newData.val().matches(/^(manual|ai|simulated)$/)" },
            "persona": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "axes": { "$i": { "$field": { ".validate": true } } },
            "tally": { "$letter": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
            "answers": {
              "$questionNo": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
